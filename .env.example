# Local development environment variables
# Copy this file to .env and fill in your values

NODE_ENV=development
DATA_DIR=./data
STAGING_DIR=staging
RCLONE_URL=http://localhost:5572
RCLONE_REMOTE=audiobooks:
DB_FILENAME=audiobook-archive.db
PORT=3001
LOG_LEVEL=debug

# Audible activation bytes for AAX decryption
# Get these from https://audible-tools.kamsker.at or inAudible-NG/audible-activator
ACTIVATION_BYTES=
